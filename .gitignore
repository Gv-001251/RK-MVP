# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Raw analyzer captures and spools. These contain real patient data — HL7
# messages carry names, results and histograms — so they must never be
# committed. The bridges write here at runtime.
/tmp/

# Testing-mode PDF captures of received analyzer results (LIS_DUMP_RESULTS_PDF).
# Contain result data — never commit.
/received-results/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Desktop app build output (Electron bundle + installer)
dist-desktop/

# Bundled desktop output (generated by npm run desktop:build)
build/

# Files staged next to the installer (generated by npm run desktop:kit).
# Contains the generated database password in plaintext and bcrypt staff hashes.
install-kit/

# Vendor analyzer software, dropped in for reference while writing the drivers.
# ~770 MB of third-party Windows binaries (Snibe Maglumi/SnibeLis, incl. its
# installer) that are not ours to redistribute, plus encrypted vendor config.
# The findings taken from them are written down in the code that needs them:
# tools/lis-bridge/lib/hl7.mjs, lib/maglumi-assays.mjs, mysql/021_maglumi_tcp.sql.
/Maglumi 800/
/Maglumi 800_*.exe
/SnibeLis/

# Copied into the share site by scripts/share-installer.mjs on every run. The
# original is deploy/setup-windows.ps1; this is a build artifact of the deploy.
/deploy/share-site/setup-windows.ps1
